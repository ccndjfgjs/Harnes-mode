# Личная документация проекта (русское описание для пользователя).
# Не должна попадать в общую историю репозитория.
Документация/

# Локальный установщик и его распакованная сборка: крупные двоичные файлы
# (установщик ~121 МБ), которые пересобираются из electron-builder.yml.
# В истории Git такие файлы остаются навсегда и раздувают репозиторий.
installer/

# Личные данные работы агента: журналы сессий, настройки, хранилища.
dsh_home/

# Локальные файлы окружения. Образец .env.example остаётся в репозитории.
.env.*
!.env.example
test1.env
test2.env

# Журналы и кэш локальных запусков.
install.log
junction-log.txt
launcher-log.txt
